+"""Array Subset: preserve separate index/length pairs for every axis."""
+
+from lvkit.models import LVTypeKind
+
+from ..ast_utils import build_assign, parse_expr
+from ..elementwise import LV_IMPORT
+from ..fragment import CodeFragment
+from .base import CodeGenError
+
+
+def generate(node, ctx):
+    terms = {term.index: term for term in node.terminals}
+    array, output = terms.get(0), terms.get(1)
+    if array is None or array.lv_type is None or array.lv_type.kind != LVTypeKind.ARRAY:
+        raise CodeGenError("Array Subset requires a typed array", node)
+    rank = array.lv_type.dimensions
+    if not isinstance(rank, int) or rank < 1 or output is None:
+        raise CodeGenError("Array Subset rank or output is unknown", node)
+    if set(terms) != set(range(2 + 2 * rank)):
+        raise CodeGenError("Unrecognized Array Subset index/length pane", node)
+    bounds = []
+    for axis in range(rank):
+        pair = []
+        for position, default in ((2 + 2 * axis, "0"), (3 + 2 * axis, "None")):
+            term = terms[position]
+            if term.direction != "input":
+                raise CodeGenError("Array Subset boundary must be input", node)
+            value = ctx.resolve(term.id) if ctx.graph.terminal_is_wired(term.id) else default
+            if value is None:
+                raise CodeGenError("Array Subset wired boundary is unresolved", node)
+            pair.append(value)
+        bounds.append("(" + ", ".join(pair) + ")")
+    array_value = ctx.resolve(array.id)
+    if array_value is None:
+        raise CodeGenError("Array Subset array is unresolved", node)
+    variable = ctx.make_output_var("subarray", output.id)
+    expression = f"_lv.array_subset_nd({array_value}, [{', '.join(bounds)}])"
+    ctx.array_vars.add(variable)
+    return CodeFragment(statements=[build_assign(variable, parse_expr(expression))],
+                        bindings={output.id: variable}, imports={LV_IMPORT})
