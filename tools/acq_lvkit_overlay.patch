+def _position_path(
+    term: Terminal, fields: list[ClusterField] | None
+) -> tuple[int, ...]:
+    """Depth-first nMux index to nested tuple path, including parent fields."""
+    paths: list[tuple[int, ...]] = []
+
+    def visit(current: list[ClusterField], prefix: tuple[int, ...]) -> None:
+        for i, field in enumerate(current):
+            path = prefix + (i,)
+            paths.append(path)
+            if field.type and field.type.fields:
+                visit(field.type.fields, path)
+
+    visit(fields or [], ())
+    index = term.nmux_field_index
+    if index is None or index < 0 or index >= len(paths):
+        raise TypeResolutionNeeded(
+            type_name=f"positional field[{index}]", context=term.id
+        )
+    return paths[index]
+
+
