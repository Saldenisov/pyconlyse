+++ b/tests/test_supervision_parser_regressions.py
@@ -0,0 +1,163 @@
+"""Stored identities, not diagram/FP order, govern Supervision parsing."""
+
+from __future__ import annotations
+
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from types import SimpleNamespace
+
+import networkx as nx
+import pytest
+
+from lvkit import extractor
+from lvkit.graph.builders.refs import GRefHandler
+from lvkit.graph.models import WireEnd
+from lvkit.parser.models import ParsedBlockDiagram, ParsedTerminalInfo, ParsedType, SelectorTable
+from lvkit.parser.node_types import GRefHandler as ParseGRef
+from lvkit.parser.nodes.case import extract_case_structures
+from lvkit.parser.vi import _parse_front_panel
+
+
+def case_xml(default=None):
+    root = ET.fromstring('''<root><SL__arrayElement class="select" uid="case">
+      <termList><SL__arrayElement class="term" uid="sel"><dco class="caseSel"/></SL__arrayElement></termList>
+      <SelectRangeArray32>
+        <SL__arrayElement class="SelectorRange"><start>0</start><end>0</end><diagramIdx>0</diagramIdx></SL__arrayElement>
+        <SL__arrayElement class="SelectorRange"><start>1</start><end>1</end><diagramIdx>1</diagramIdx></SL__arrayElement>
+        <SL__arrayElement class="SelectorRange"><start>2</start><end>2</end><diagramIdx>2</diagramIdx></SL__arrayElement>
+      </SelectRangeArray32><diagramList>
+        <SL__arrayElement class="diag" uid="a"/><SL__arrayElement class="diag" uid="b"/><SL__arrayElement class="diag" uid="c"/>
+      </diagramList></SL__arrayElement></root>''')
+    if default is not None:
+        ET.SubElement(root[0], "SelectDefaultCase").text = default
+    return root
+
+
+def terminal_info(name="NumInt32"):
+    return {"sel": ParsedTerminalInfo(uid="sel", parent_uid="case", index=0,
+        parsed_type=ParsedType(kind="primitive", type_name=name))}
+
+
+def test_omitted_zero_default_keeps_its_explicit_value_and_range():
+    case = extract_case_structures(case_xml(), terminal_info())[0]
+    assert [f.is_default for f in case.frames] == [True, False, False]
+    assert [f.selector_value for f in case.frames] == ["0", "1", "2"]
+    assert [(r.start, r.end) for r in case.frames[0].selector_ranges] == [(0, 0)]
+
+
+@pytest.mark.parametrize("default,index", [("00", 0), ("01", 1), ("02", 2)])
+def test_explicit_default_identity(default, index):
+    case = extract_case_structures(case_xml(default), terminal_info())[0]
+    assert [f.is_default for f in case.frames] == [i == index for i in range(3)]
+    assert case.frames[index].selector_value == str(index)
+
+
+def test_explicit_ff_does_not_guess_a_default():
+    case = extract_case_structures(case_xml("FF"), terminal_info())[0]
+    assert not any(f.is_default for f in case.frames)
+
+
+@pytest.mark.parametrize("default", ["03", "-1", "garbage", ""])
+def test_invalid_default_refused(default):
+    with pytest.raises(ValueError):
+        extract_case_structures(case_xml(default), terminal_info())
+
+
+def test_dataspace_table_does_not_erase_stored_default():
+    root = case_xml("01")
+    ET.SubElement(root[0].find("termList")[0][0], "typeDesc").text = "TypeID(1)"
+    table = SelectorTable(type_id=1, displayed_frame=2,
+        ranges=[(20, 20, 0), (10, 10, 1), (30, 30, 2)])
+    case = extract_case_structures(root, terminal_info(), [table])[0]
+    assert [f.is_default for f in case.frames] == [False, True, False]
+    assert [f.selector_value for f in case.frames] == ["20", "10", "30"]
+
+
+def panel(tmp_path, references=("B", "A"), declared="2"):
+    root = ET.fromstring('<FPHb><root class="supC"/></FPHb>')
+    lst = ET.SubElement(root[0], "ddoList", elements=declared)
+    for uid in references:
+        ET.SubElement(lst, "SL__arrayElement", uid=uid)
+    plane = ET.SubElement(root[0], "zPlaneList")
+    for uid, name in (("A", "DrawnFirst"), ("B", "StoredFirst")):
+        control = ET.SubElement(plane, "SL__arrayElement", {"class": "fPDCO", "uid": uid})
+        ddo = ET.SubElement(control, "ddo", {"class": "stdNumeric", "uid": uid+"ddo"})
+        ET.SubElement(ddo, "bounds").text = "(0, 0, 20, 80)"
+        parts = ET.SubElement(ddo, "partsList")
+        label = ET.SubElement(parts, "SL__arrayElement", {"class": "label"})
+        ET.SubElement(label, "partID").text = "16"
+        text = ET.SubElement(label, "textRec")
+        ET.SubElement(text, "text").text = '"'+name+'"'
+    path = tmp_path / "panel.xml"
+    ET.ElementTree(root).write(path)
+    return _parse_front_panel(path, ParsedBlockDiagram(nodes=[], constants=[], wires=[]))
+
+
+def test_local_index_uses_stored_fpdco_table_not_drawn_order(tmp_path):
+    fp = panel(tmp_path)
+    assert [c.uid for c in fp.controls] == ["A", "B"]
+    assert fp.local_control_uids == {0: "B", 1: "A"}
+    graph = nx.MultiDiGraph()
+    ctx = SimpleNamespace(fp=fp, param_wire_ends={0: WireEnd(
+        terminal_id="VI::Bterm", node_id="VI", index=0, name="StoredFirst")},
+        vi_name="VI", graph=graph, bd=SimpleNamespace(terminal_info={}), vi_node_uids=set())
+    node = ParseGRef().parse(ET.fromstring('''<SL__arrayElement class="gRef" uid="local">
+        <termList><SL__arrayElement class="term" uid="localterm"><dco class="gRefDCO"/></SL__arrayElement></termList>
+        </SL__arrayElement>'''))
+    ctx.qid = lambda uid: "VI::"+uid
+    assert node.param_idx == 0
+    assert GRefHandler().handle(node, "VI::local", ctx)
+    local = graph.nodes["VI::local"]["node"]
+    assert local.control_name == "StoredFirst"
+    assert local.control_terminal_id == "VI::Bterm"
+
+
+@pytest.mark.parametrize("refs,declared", [(("A","A"), "2"), (("A","missing"), "2"), (("B","A"), "3")])
+def test_corrupt_local_table_never_falls_back_to_control_order(tmp_path, refs, declared):
+    assert panel(tmp_path, refs, declared).local_control_uids == {}
+
+
+def test_missing_local_table_stays_unresolved(tmp_path):
+    fp = panel(tmp_path)
+    assert fp.local_control_uids
+    path = tmp_path / "panel.xml"
+    root = ET.parse(path).getroot()
+    root[0].remove(root[0].find("ddoList"))
+    ET.ElementTree(root).write(path)
+    assert _parse_front_panel(path, ParsedBlockDiagram(nodes=[], constants=[], wires=[])).local_control_uids == {}
+
+
+def test_llb_lazy_stream_survives_factory_return(monkeypatch, tmp_path):
+    import pylabview.LVrsrcontainer as lvrsrc
+    archive = tmp_path / "archive.llb"
+    archive.write_bytes(b"lazy member")
+    monkeypatch.setattr(lvrsrc, "VI", lambda po, rsrc_fh, text_encoding: rsrc_fh)
+    stream = extractor._open_llb_vi(archive)
+    assert not stream.closed
+    assert stream.name == str(archive)
+    assert stream.read() == b"lazy member"
+
+
+def test_failed_llb_extraction_does_not_create_success_marker(monkeypatch, tmp_path):
+    archive = tmp_path / "archive.llb"
+    archive.write_bytes(b"no readable members")
+    cache = tmp_path / "cache"
+    monkeypatch.setattr(extractor, "_llb_cache_dir", lambda path: cache)
+    monkeypatch.setattr(extractor, "_open_llb_vi", lambda path: SimpleNamespace(get=lambda ident: None))
+    with pytest.raises(RuntimeError, match="No readable VI members"):
+        extractor.extract_llb(archive)
+    assert not (cache / ".extracted").exists()
+
+
+def test_stale_empty_cache_not_accepted(monkeypatch, tmp_path):
+    archive = tmp_path / "archive.llb"
+    archive.write_bytes(b"source")
+    cache = tmp_path / "cache"
+    cache.mkdir()
+    (cache / ".extracted").touch()
+    opened = []
+    monkeypatch.setattr(extractor, "_llb_cache_dir", lambda path: cache)
+    monkeypatch.setattr(extractor, "_open_llb_vi", lambda path: opened.append(path) or SimpleNamespace(get=lambda ident: None))
+    with pytest.raises(RuntimeError):
+        extractor.extract_llb(archive)
+    assert opened == [archive.resolve()]
