+"""Typed numeric templates must not confuse literals with Build Array."""
+
+import ast
+
+import pytest
+
+from lvkit.codegen.elementwise import arrayify, arrayify_module
+from lvkit.runtime import lv
+
+
+@pytest.mark.parametrize(
+    "expression",
+    ("bank + [0.0, -2.0, -2.0]", "[0.0, -2.0, -2.0] + bank", "[1, 2] + [3, 4]"),
+)
+def test_typed_numeric_add_literal_uses_elementwise_helper(expression):
+    generated, used = arrayify(ast.parse(expression, mode="eval").body)
+    assert used
+    assert isinstance(generated, ast.Call)
+    assert ast.unparse(generated.func) == "_lv.add"
+
+
+def test_numeric_offset_retains_shape_and_input():
+    expression, _ = arrayify(ast.parse("bank + [0.0, -2.0, -2.0]", mode="eval").body)
+    bank = [1.0, 4.0, 5.0]
+    actual = eval(
+        compile(ast.Expression(expression), "<numeric-template>", "eval"),
+        {"__builtins__": {}, "_lv": lv, "bank": bank},
+    )
+    assert actual == [1.0, 2.0, 3.0]
+    assert bank == [1.0, 4.0, 5.0]
+
+
+@pytest.mark.parametrize(
+    "statement",
+    ("result = bank + [new]", "result = bank[:1] + [new] + bank[2:]"),
+)
+def test_module_build_replace_array_concatenation_stays_unchanged(statement):
+    body = ast.parse(statement).body
+    assert not arrayify_module(body, frozenset({"bank"}))
+    assert ast.unparse(body[0]) == statement
