diff --git a/src/lvkit/codegen/nodes/local_variable.py b/src/lvkit/codegen/nodes/local_variable.py
new file mode 100644
--- /dev/null
+++ b/src/lvkit/codegen/nodes/local_variable.py
@@ -0,0 +1,43 @@
+"""Local reads/writes for an explicitly reviewed sequential simulation."""
+
+from __future__ import annotations
+
+import ast
+
+from lvkit.graph.models import CaseStructureNode, EventStructureNode, LoopNode
+
+from ..ast_utils import parse_expr
+from ..fragment import CodeFragment
+from .base import UnknownNodeError
+
+_CONDITIONAL_STRUCTURES = (CaseStructureNode, EventStructureNode, LoopNode)
+
+
+def generate(node, ctx) -> CodeFragment:
+    control = node.control_terminal_id
+    reviewed = getattr(ctx.graph, "reviewed_local_bindings", {})
+    if not control or reviewed.get(node.id) != control:
+        raise UnknownNodeError(f"unreviewed local control binding: {node.id}")
+    if node.is_write:
+        # Binding a write nested inside a branch as an unconditional function
+        # result loses the old indicator value (or creates an unbound local).
+        # The sequential adapter does not implement persistent panel state.
+        parent = node.parent
+        while parent:
+            ancestor = ctx.graph._graph.nodes[parent].get("node")
+            if isinstance(ancestor, _CONDITIONAL_STRUCTURES):
+                raise UnknownNodeError(
+                    "conditional local write requires persistent-state model: "
+                    f"{node.id}"
+                )
+            parent = ancestor.parent if ancestor else None
+    value = ctx.resolve(node.terminals[0].id if node.is_write else control)
+    if value is None:
+        raise UnknownNodeError(f"local value is not initialized/resolved: {node.id}")
+    if not node.is_write:
+        return CodeFragment(bindings={node.terminals[0].id: value})
+    variable = "local_" + control.rsplit("::", 1)[-1]
+    statement = ast.Assign(
+        targets=[ast.Name(id=variable, ctx=ast.Store())], value=parse_expr(value)
+    )
+    return CodeFragment(statements=[statement], bindings={control: variable})
diff --git a/src/lvkit/codegen/nodes/ops/real64_log10.py b/src/lvkit/codegen/nodes/ops/real64_log10.py
new file mode 100644
--- /dev/null
+++ b/src/lvkit/codegen/nodes/ops/real64_log10.py
@@ -0,0 +1,25 @@
+"""Real DBL log10, including arrays; reject unqualified representations."""
+
+from lvkit.models import LVTypeKind
+
+from ..base import CodeGenError
+from . import register_op
+
+
+def is_real64(lv_type):
+    if lv_type is None:
+        return False
+    if lv_type.kind == LVTypeKind.ARRAY:
+        return is_real64(lv_type.element_type)
+    return (
+        lv_type.kind == LVTypeKind.PRIMITIVE and lv_type.underlying_type == "NumFloat64"
+    )
+
+
+@register_op("REAL64_LOG10")
+def real64_log10(node, resolved):
+    if not node.terminals or not all(is_real64(t.lv_type) for t in node.terminals):
+        raise CodeGenError(
+            "log10 currently qualified only for real DBL/DBL arrays", node
+        )
+    return {"log(x)": "_lv.log10(in_1)"}
diff --git a/src/lvkit/positional_cluster.py b/src/lvkit/positional_cluster.py
new file mode 100644
--- /dev/null
+++ b/src/lvkit/positional_cluster.py
@@ -0,0 +1,23 @@
+"""By-value updates of anonymous nested clusters represented as tuples."""
+
+from __future__ import annotations
+
+
+def replace_fields(
+    cluster: tuple, updates: tuple[tuple[tuple[int, ...], object], ...]
+) -> tuple:
+    """Copy only changed tuple branches; never mutate the input cluster."""
+    if type(cluster) is not tuple:
+        raise TypeError("anonymous cluster must be a tuple")
+    result = cluster
+    for path, value in updates:
+        if not path or any(type(index) is not int or index < 0 for index in path):
+            raise ValueError("nonempty nonnegative cluster index path required")
+        index, *tail = path
+        if index >= len(result):
+            raise IndexError(path)
+        replacement = (
+            replace_fields(result[index], ((tuple(tail), value),)) if tail else value
+        )
+        result = result[:index] + (replacement,) + result[index + 1 :]
+    return result
diff --git a/src/lvkit/reviewed_locals.py b/src/lvkit/reviewed_locals.py
new file mode 100644
--- /dev/null
+++ b/src/lvkit/reviewed_locals.py
@@ -0,0 +1,72 @@
+"""Explicit source-reviewed local-variable binding, without FP-order guesses.
+
+This is an opt-in simulation profile for sequential diagrams. It does not
+infer bank/control correspondence, persistence, or concurrent scheduling.
+"""
+
+from __future__ import annotations
+
+from lvkit.graph.models import LocalVariableNode, WireEnd
+
+
+def _shape(lv_type):
+    if lv_type is None:
+        return None
+    return (
+        lv_type.kind,
+        lv_type.underlying_type,
+        lv_type.ref_type,
+        lv_type.classname,
+        tuple(_shape(field.type) for field in lv_type.fields or []),
+        _shape(lv_type.element_type),
+        lv_type.dimensions,
+    )
+
+
+def configure_reviewed_locals(graph, vi_key: str, bindings: dict[str, str]) -> None:
+    """Bind every local node UID to an explicitly reviewed FP terminal UID."""
+    locals_by_uid = {
+        uid.rsplit("::", 1)[-1]: data["node"]
+        for uid, data in graph._graph.nodes(data=True)
+        if isinstance(data.get("node"), LocalVariableNode)
+        and data["node"].vi_path == vi_key
+    }
+    if set(bindings) != set(locals_by_uid):
+        raise ValueError("every local UID needs an explicit reviewed binding")
+    controls = {
+        t.id.rsplit("::", 1)[-1]: t
+        for t in graph._graph.nodes[vi_key]["node"].terminals
+    }
+    if any(target not in controls for target in bindings.values()):
+        raise ValueError("reviewed control terminal UID not present")
+    for raw_uid, target in bindings.items():
+        local_type = _shape(locals_by_uid[raw_uid].terminals[0].lv_type)
+        if local_type is None or local_type != _shape(controls[target].lv_type):
+            raise ValueError("reviewed local/control type shape mismatch")
+    for raw_uid, target in bindings.items():
+        node = locals_by_uid[raw_uid]
+        control = controls[target]
+        # Remove only synthetic FP/local aliases, not the drawn diagram wires.
+        for src, dst, edge_key in list(graph._graph.edges(keys=True)):
+            if (src == node.id and dst == vi_key) or (src == vi_key and dst == node.id):
+                graph._graph.remove_edge(src, dst, edge_key)
+        node.name = node.control_name = control.name
+        node.control_terminal_id = control.id
+        fp_end = WireEnd(
+            terminal_id=control.id,
+            node_id=vi_key,
+            index=control.index,
+            name=control.name,
+            parent_kind="vi",
+        )
+        local_end = WireEnd(
+            terminal_id=node.terminals[0].id,
+            node_id=node.id,
+            index=0,
+            name=control.name,
+        )
+        if node.is_write:
+            graph._graph.add_edge(node.id, vi_key, source=local_end, dest=fp_end)
+        else:
+            graph._graph.add_edge(vi_key, node.id, source=fp_end, dest=local_end)
+        graph.reviewed_local_bindings[node.id] = control.id
