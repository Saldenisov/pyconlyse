+++ b/tests/test_property_numeric_coercion.py
@@ -0,0 +1,91 @@
+"""Synthetic scalar property coercion fixtures, without proprietary VIs."""
+
+import ast
+from types import SimpleNamespace
+
+import pytest
+
+from lvkit.codegen.context import CodeGenContext
+from lvkit.codegen.nodes.base import CodeGenError
+from lvkit.codegen.nodes.property_node import generate
+from lvkit.graph import InMemoryVIGraph
+from lvkit.graph.models import PrimitiveNode, WireEnd
+from lvkit.models import LVType, LVTypeKind, PropertyDef, Terminal
+
+
+def fixture(source_type):
+    def lv_type(name):
+        return LVType(kind=LVTypeKind.PRIMITIVE, underlying_type=name) if name else None
+
+    source = PrimitiveNode(
+        id="source",
+        vi_path="synthetic.vi",
+        terminals=[
+            Terminal(
+                id="value_out",
+                index=0,
+                direction="output",
+                lv_type=lv_type(source_type),
+            )
+        ],
+    )
+    prop = PrimitiveNode(
+        id="property",
+        vi_path="synthetic.vi",
+        node_type="propNode",
+        terminals=[
+            Terminal(id="ref", index=0, direction="input", lv_type=lv_type("Refnum")),
+            Terminal(
+                id="value_in", index=1, direction="input", lv_type=lv_type("NumUInt32")
+            ),
+        ],
+        properties=[PropertyDef(name="ticks")],
+        property_value_terminal_ids=["value_in"],
+    )
+    graph = InMemoryVIGraph()
+    for node in (source, prop):
+        graph._graph.add_node(node.id, node=node)
+        for term in node.terminals:
+            graph._term_to_node[term.id] = node.id
+    graph._graph.add_edge(
+        "source",
+        "property",
+        source=WireEnd(terminal_id="value_out", node_id="source"),
+        dest=WireEnd(terminal_id="value_in", node_id="property"),
+    )
+    ctx = CodeGenContext(graph=graph)
+    ctx.bind("ref", "task")
+    ctx.bind("value_out", "value")
+    return prop, ctx
+
+
+@pytest.mark.parametrize(
+    "value,expected",
+    [(-1, 4294967295), (-2147483648, 2147483648), (0, 0), (2147483647, 2147483647)],
+)
+def test_i32_wire_to_u32_property_retains_bits(value, expected):
+    prop, ctx = fixture("NumInt32")
+    fragment = generate(prop, ctx)
+    module = ast.fix_missing_locations(
+        ast.Module(body=fragment.statements, type_ignores=[])
+    )
+    task = SimpleNamespace()
+    exec(
+        compile(module, "<synthetic-property>", "exec"),
+        {"__builtins__": {}, "task": task, "value": value},
+    )
+    assert task.ticks == expected
+
+
+def test_matching_u32_source_is_not_masked():
+    prop, ctx = fixture("NumUInt32")
+    statement = generate(prop, ctx).statements[0]
+    assert isinstance(statement.value, ast.Name)
+    assert statement.value.id == "value"
+
+
+@pytest.mark.parametrize("source_type", [None, "NumFloat64", "NumUInt16", "NumInt64"])
+def test_unqualified_u32_source_raises(source_type):
+    prop, ctx = fixture(source_type)
+    with pytest.raises(CodeGenError):
+        generate(prop, ctx)
