+    target = term.lv_type
+    if not (
+        target
+        and target.kind == LVTypeKind.PRIMITIVE
+        and target.underlying_type == "NumUInt32"
+    ):
+        return parse_expr(value)
+    sources = ctx.graph.incoming_edges(term.id) if ctx.graph else []
+    if not sources:
+        return parse_expr(value)
+    if len(sources) != 1:
+        raise CodeGenError("U32 property source is ambiguous", node)
+    source = ctx.graph.get_terminal(sources[0].terminal_id)
+    source_type = source.lv_type if source else None
+    if not source_type or source_type.kind != LVTypeKind.PRIMITIVE:
+        raise CodeGenError("U32 property source type is unresolved", node)
+    if source_type.underlying_type == "NumUInt32":
+        return parse_expr(value)
+    if source_type.underlying_type == "NumInt32":
+        return ast.BinOp(
+            left=parse_expr(value), op=ast.BitAnd(), right=ast.Constant(0xFFFFFFFF)
+        )
+    raise CodeGenError("conversion to U32 property is unqualified", node)
 
 
