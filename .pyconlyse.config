# PYCONLYSE Project Configuration
# This file contains default settings for the PYCONLYSE project

[Environment]
# Default Conda environment for PYCONLYSE
DEFAULT_CONDA_ENV=pyconlyse39

# Project directories (relative to project root)
BIN_DIR=bin
DEVICESERVERS_DIR=DeviceServers
LEGACY_DIR=bin/legacy

[Startup]
# Default startup script
MAIN_CONTROL_SCRIPT=main_ctrl.py
TANGO_STARTUP_SCRIPT=start_tango_improved.cmd
DEVICESERVER_TEMPLATE=start_deviceserver.cmd

[Desktop]
# Desktop shortcuts created (OneDrive synced desktop)
DESKTOP_LAUNCHER=OneDrive\Desktop\PYCONLYSE Control Center.cmd
DESKTOP_SHORTCUT=OneDrive\Desktop\soft\PYCONLYSE Control Center.lnk
POWERSHELL_LAUNCHER=OneDrive\Desktop\Start-PYCONLYSE.ps1

[Version]
PYCONLYSE_VERSION=2.0
CONFIG_VERSION=1.0
LAST_UPDATED=2025-01-18

[Required_Environment_Variables]
# These environment variables must be set for the system to work
PYCONLYSE=Project root directory (e.g., C:\dev\pyconlyse)
ANACONDA=Anaconda installation directory (e.g., C:\Users\username\anaconda3)
TANGO_ROOT=Tango installation directory (e.g., C:\dev\tango_root\tango)
PYCONLYSE_ENV=Conda environment name (default: pyconlyse39)

[Optional_Environment_Variables]
# These can be set to override defaults
TANGO_HOST=Tango database host (default: localhost:10000)

[Notes]
# The pyconlyse39 conda environment should contain:
# - PyQt5
# - PyTango/Taurus
# - NumPy, SciPy
# - ZMQ (pyzmq)
# - imageio
# - keyboard
# - All other project dependencies